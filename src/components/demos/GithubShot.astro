---
// GitHub 대화 캡처를 블로그 테마에 맞춰 라이트/다크 이미지로 바꿔 보여 주고, 원문으로 연결한다.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  href: string;
  caption?: string;
}
const { light, dark, alt, href, caption } = Astro.props;
---
<figure class="gh-shot">
  <a href={href} rel="noopener" aria-label={`${alt} (GitHub에서 보기)`}>
    <Image class="light" src={light} alt={alt} widths={[640, 1136]} sizes="(max-width: 720px) 100vw, 640px" />
    <Image class="dark" src={dark} alt="" aria-hidden="true" widths={[640, 1136]} sizes="(max-width: 720px) 100vw, 640px" />
  </a>
  {caption && <figcaption>{caption} · <a href={href} rel="noopener">GitHub에서 보기 ↗</a></figcaption>}
</figure>

<style is:global>
  .article .gh-shot { margin:24px 0; }
  .article .gh-shot > a { display:block; max-width:568px; }
  .article .gh-shot img { display:block; width:100%; height:auto; border-radius:8px; }
  .article .gh-shot .dark, :root[data-theme="dark"] .article .gh-shot .light { display:none; }
  :root[data-theme="dark"] .article .gh-shot .dark { display:block; }
  .article .gh-shot figcaption { margin-top:8px; font-size:12.5px; color:var(--ink-3); }
  .article .gh-shot figcaption a { color:var(--accent); }
</style>
