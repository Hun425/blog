---
// 이슈 #6938: 논블로킹 경로에서 onReady()가 같은 호출 스택 안에서 다시 불려 응답이 중복되는 과정을 보여 준다.
import DemoFrame from './DemoFrame.astro';
---
<DemoFrame
  label="onReady() 재진입 비교. 논블로킹 경로에서는 응답을 쓰는 도중 whenConsumed 콜백이 같은 호출 스택에서 invokeOnReady()를 불러 onReady()가 다시 실행되고, 요청 필드가 아직 비워지지 않아 같은 응답이 두 번 나간다. blocking executor 경로에서는 invokeOnReady()가 큐로 넘어가 스택이 다 풀린 뒤 실행되므로 응답은 한 번만 나간다."
  caption="요청 하나를 받은 reflection 서비스의 호출 스택. 아래에서 위로 쌓인다. 버튼으로 한 단계씩 넘겨 볼 수 있다."
>
  <canvas data-demo="reentrancy"></canvas>
  <div class="demo-controls" data-controls>
    <button type="button" data-act="prev" aria-label="이전 단계">◀</button>
    <button type="button" data-act="toggle" aria-label="일시정지">❚❚</button>
    <button type="button" data-act="next" aria-label="다음 단계">▶</button>
    <span class="steps" data-steps></span>
    <span class="count" data-count></span>
    <span class="sr-note" aria-live="polite" data-live></span>
  </div>
</DemoFrame>

<style is:global>
  .article .demo-controls { display:flex; align-items:center; gap:6px; margin-top:12px; flex-wrap:wrap; }
  .article .demo-controls button { font:inherit; font-size:12px; line-height:1; min-width:34px; height:30px; padding:0 10px; border-radius:6px; border:1px solid var(--line); background:var(--surface); color:var(--ink-2); cursor:pointer; }
  .article .demo-controls button:hover { border-color:var(--accent); color:var(--accent); }
  .article .demo-controls .steps { display:flex; align-items:center; gap:4px; margin-left:6px; }
  .article .demo-controls .steps button { min-width:0; width:9px; height:9px; padding:0; border-radius:5px; border:none; background:var(--line); position:relative; overflow:hidden; transition:width .2s; }
  .article .demo-controls .steps button.done { background:color-mix(in srgb,var(--accent) 45%,var(--line)); }
  .article .demo-controls .steps button.on { width:26px; }
  .article .demo-controls .steps button.on::after { content:""; position:absolute; inset:0 auto 0 0; width:var(--prog,0%); background:var(--accent); }
  .article .demo-controls .count { margin-left:auto; font-family:"IBM Plex Mono",monospace; font-size:12px; color:var(--ink-3); }
  .article .demo-controls .sr-note { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; }
</style>

<script>
  import { mountDemo, roundRect, mix, seg, ease, type Frame } from './canvas';

  type Tone = 'normal' | 'danger' | 'queued';
  type Ev =
    | { t: number; push: string; tone?: Tone }
    | { t: number; pop: true }
    | { t: number; field: string | null }
    | { t: number; send: 'ok' | 'dup' }
    | { t: number; enqueue: string }
    | { t: number; dequeue: true }
    | { t: number; note: string };

  type Scenario = { title: string; sub: string; queue: boolean; events: Ev[] };

  // t 는 단계 번호. 소수부는 그 단계 안에서의 지연(초)이다.
  const reentrant: Scenario = {
    title: '논블로킹 경로',
    sub: 'invokeOnReady()를 바로 호출',
    queue: false,
    events: [
      { t: 0, push: 'onReady()' },
      { t: 0, field: '요청 1' },
      { t: 0, note: '요청 1을 받아 onReady()가 실행된다' },
      { t: 1, push: 'sendMessage(응답)' },
      { t: 1.3, send: 'ok' },
      { t: 1, note: '응답을 쓴다' },
      { t: 2, push: 'whenConsumed 콜백' },
      { t: 2, note: '응답이 바로 소비돼 콜백이 같은 스택에서 실행된다' },
      { t: 3, push: 'invokeOnReady()' },
      { t: 3, note: '콜백이 invokeOnReady()를 바로 부른다' },
      { t: 4, push: 'onReady()  ← 재진입', tone: 'danger' },
      { t: 4, note: 'onReady()가 같은 스택에서 다시 실행된다. 요청 필드에는 아직 요청 1이 남아 있다' },
      { t: 5, push: 'sendMessage(응답)', tone: 'danger' },
      { t: 5.3, send: 'dup' },
      { t: 5, note: '같은 요청을 또 처리해서 응답이 한 번 더 나간다' },
      { t: 6, field: null },
      { t: 6, note: '그제야 필드를 비우지만 이미 두 번 보냈다' },
      { t: 7, note: '스택이 풀리기 전에 같은 요청이 두 번 처리됐다' },
      { t: 8, note: '결과: 요청 1개에 응답 2개' },
    ],
  };

  const queued: Scenario = {
    title: 'blocking executor 경로',
    sub: 'invokeOnReady()를 executor에 넘김',
    queue: true,
    events: [
      { t: 0, push: 'onReady()' },
      { t: 0, field: '요청 1' },
      { t: 0, note: '요청 1을 받아 onReady()가 실행된다' },
      { t: 1, push: 'sendMessage(응답)' },
      { t: 1.3, send: 'ok' },
      { t: 1, note: '응답을 쓴다' },
      { t: 2, push: 'whenConsumed 콜백' },
      { t: 2, note: '응답이 바로 소비돼 콜백이 실행된다' },
      { t: 3, enqueue: 'invokeOnReady()' },
      { t: 3, note: '바로 부르지 않고 executor 큐에 넣는다' },
      { t: 4, pop: true }, { t: 4.3, pop: true },
      { t: 4, note: '콜백과 sendMessage()가 끝나 스택이 풀린다' },
      { t: 5, field: null },
      { t: 5, note: '응답을 쓴 뒤 필드를 비운다' },
      { t: 6, pop: true },
      { t: 6, note: '첫 onReady()가 끝나 스택이 비었다' },
      { t: 7, dequeue: true },
      { t: 7, note: '이제 큐에 있던 onReady()가 실행된다' },
      { t: 8, note: '필드가 비어 있으니 보낼 것이 없다. 응답은 1개' },
    ],
  };

  /** 단계별 머무는 시간(ms). 재진입·중복이 보이는 4, 5단계와 결과는 더 오래 둔다 */
  const STEP_MS = [2600, 2600, 3000, 3000, 4200, 4200, 3200, 3200, 5000];
  const STEPS = STEP_MS.length;

  type Frm = { label: string; tone: Tone; t: number };
  type State = { stack: Frm[]; popped: { f: Frm; depth: number; t: number }[]; field: string | null; fieldT: number; sent: { kind: 'ok' | 'dup'; t: number }[]; queue: { label: string; t: number }[]; note: string; noteT: number };

  function stateAt(s: Scenario, v: number): State {
    const st: State = { stack: [], popped: [], field: null, fieldT: 0, sent: [], queue: [], note: '', noteT: 0 };
    for (const e of s.events) {
      if (e.t > v) continue;
      if ('push' in e) st.stack.push({ label: e.push, tone: e.tone ?? 'normal', t: e.t });
      else if ('pop' in e) { const f = st.stack.pop(); if (f) st.popped.push({ f, depth: st.stack.length, t: e.t }); }
      else if ('field' in e) { st.field = e.field; st.fieldT = e.t; }
      else if ('send' in e) st.sent.push({ kind: e.send, t: e.t });
      else if ('enqueue' in e) st.queue.push({ label: e.enqueue, t: e.t });
      else if ('dequeue' in e) { const q = st.queue.shift(); if (q) st.stack.push({ label: 'onReady()', tone: 'queued', t: e.t }); }
      else if ('note' in e) { st.note = e.note; st.noteT = e.t; }
    }
    return st;
  }

  const FRAME_H = 26;
  const FRAME_GAP = 4;
  const MAX_DEPTH = 6;
  const STACK_H = MAX_DEPTH * (FRAME_H + FRAME_GAP);
  const HEAD_H = 62;
  const NOTE_H = 40;
  const PANEL_H = HEAD_H + STACK_H + 12 + NOTE_H;

  function drawPanel(f: Frame, s: Scenario, left: number, top: number, w: number, v: number) {
    const { ctx, colors: c, font, mono } = f;
    const st = stateAt(s, v);
    const stackW = Math.min(230, w * 0.56);
    const sideX = left + stackW + 16;
    const sideW = w - stackW - 16;

    // 제목
    ctx.textAlign = 'left';
    ctx.textBaseline = 'alphabetic';
    ctx.font = `700 14px ${font}`;
    ctx.fillStyle = c.ink;
    ctx.fillText(s.title, left, top + 14);
    ctx.font = `400 12px ${font}`;
    ctx.fillStyle = c.ink3;
    ctx.fillText(s.sub, left, top + 32, w);

    // 스택 영역
    const baseY = top + HEAD_H + STACK_H; // 스택 바닥
    ctx.font = `600 11px ${font}`;
    ctx.fillStyle = c.ink3;
    ctx.fillText('호출 스택', left, top + HEAD_H - 6);
    ctx.strokeStyle = c.line;
    ctx.beginPath();
    ctx.moveTo(left, baseY + 2);
    ctx.lineTo(left + stackW, baseY + 2);
    ctx.stroke();

    const toneColor = (tone: Tone) => (tone === 'danger' ? c.pink : tone === 'queued' ? c.teal : c.accent);
    const drawFrame = (fr: Frm, depth: number, alpha: number, dy: number) => {
      const y = baseY - (depth + 1) * (FRAME_H + FRAME_GAP) + dy;
      ctx.globalAlpha = alpha;
      roundRect(ctx, left, y, stackW, FRAME_H, 5);
      ctx.fillStyle = mix(toneColor(fr.tone), 0.14);
      ctx.fill();
      ctx.strokeStyle = toneColor(fr.tone);
      ctx.lineWidth = 1.2;
      ctx.stroke();
      ctx.lineWidth = 1;
      ctx.fillStyle = fr.tone === 'danger' ? c.pink : c.ink;
      ctx.font = `600 ${stackW < 190 ? 11 : 12}px ${mono}`;
      ctx.textBaseline = 'middle';
      ctx.fillText(fr.label, left + 8, y + FRAME_H / 2 + 0.5, stackW - 14);
      ctx.textBaseline = 'alphabetic';
      ctx.globalAlpha = 1;
    };
    st.stack.forEach((fr, i) => {
      const k = ease(seg(v, fr.t, fr.t + 0.35));
      drawFrame(fr, i, k, -(1 - k) * 14);
    });
    for (const pp of st.popped) {
      const k = seg(v, pp.t, pp.t + 0.3);
      if (k < 1) drawFrame(pp.f, pp.depth, 1 - k, -k * 10);
    }

    // 오른쪽: 요청 필드
    let y = top + HEAD_H - 6;
    ctx.font = `600 11px ${font}`;
    ctx.fillStyle = c.ink3;
    ctx.textBaseline = 'alphabetic';
    ctx.fillText('요청 필드', sideX, y);
    y += 8;
    roundRect(ctx, sideX, y, sideW, 28, 5);
    ctx.fillStyle = c.surface2;
    ctx.fill();
    const flash = 1 - seg(v, st.fieldT, st.fieldT + 0.9);
    if (flash > 0) {
      ctx.strokeStyle = mix(c.orange, flash);
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.lineWidth = 1;
    }
    ctx.font = `600 12.5px ${mono}`;
    ctx.fillStyle = st.field ? c.ink : c.ink3;
    ctx.textBaseline = 'middle';
    ctx.fillText(st.field ?? 'null', sideX + 10, y + 14.5, sideW - 16);

    // 보낸 응답
    y += 28 + 24;
    ctx.font = `600 11px ${font}`;
    ctx.fillStyle = c.ink3;
    ctx.textBaseline = 'alphabetic';
    ctx.fillText('보낸 응답', sideX, y);
    y += 8;
    const chipW = Math.min(64, (sideW - 6) / 2);
    st.sent.forEach((sd, i) => {
      const k = ease(seg(v, sd.t, sd.t + 0.4));
      const x = sideX + i * (chipW + 6);
      const col = sd.kind === 'dup' ? c.pink : c.teal;
      ctx.globalAlpha = k;
      roundRect(ctx, x, y + (1 - k) * 8, chipW, 28, 5);
      ctx.fillStyle = col;
      ctx.fill();
      ctx.fillStyle = c.onFill;
      ctx.font = `700 11.5px ${font}`;
      ctx.textBaseline = 'middle';
      ctx.textAlign = 'center';
      ctx.fillText(sd.kind === 'dup' ? '중복' : '응답', x + chipW / 2, y + 14.5 + (1 - k) * 8);
      ctx.textAlign = 'left';
      ctx.globalAlpha = 1;
    });
    if (st.sent.length === 0) {
      roundRect(ctx, sideX, y, chipW, 28, 5);
      ctx.strokeStyle = c.line;
      ctx.setLineDash([3, 3]);
      ctx.stroke();
      ctx.setLineDash([]);
    }
    y += 28 + 22;
    ctx.font = `700 13px ${mono}`;
    ctx.textBaseline = 'alphabetic';
    const dup = st.sent.some((sd) => sd.kind === 'dup');
    ctx.fillStyle = dup ? c.pink : c.ink2;
    ctx.fillText(`${st.sent.length}개 / 요청 1개`, sideX, y, sideW);

    // executor 큐
    if (s.queue) {
      y += 24;
      ctx.font = `600 11px ${font}`;
      ctx.fillStyle = c.ink3;
      ctx.fillText('executor 큐', sideX, y);
      y += 8;
      roundRect(ctx, sideX, y, sideW, 28, 5);
      ctx.strokeStyle = c.line;
      ctx.setLineDash([3, 3]);
      ctx.stroke();
      ctx.setLineDash([]);
      for (const q of st.queue) {
        const k = ease(seg(v, q.t, q.t + 0.4));
        ctx.globalAlpha = k;
        roundRect(ctx, sideX + 3, y + 3, sideW - 6, 22, 4);
        ctx.fillStyle = mix(c.teal, 0.18);
        ctx.fill();
        ctx.fillStyle = c.ink;
        ctx.font = `600 11.5px ${mono}`;
        ctx.textBaseline = 'middle';
        ctx.fillText(q.label, sideX + 10, y + 14.5, sideW - 16);
        ctx.globalAlpha = 1;
      }
    }

    // 설명 한 줄
    if (st.note) {
      const k = seg(v, st.noteT, st.noteT + 0.25);
      ctx.globalAlpha = k;
      ctx.font = `500 12.5px ${font}`;
      ctx.fillStyle = c.ink2;
      ctx.textBaseline = 'top';
      wrap(ctx, st.note, left, baseY + 14, w, 18);
      ctx.globalAlpha = 1;
      ctx.textBaseline = 'alphabetic';
    }
  }

  function wrap(ctx: CanvasRenderingContext2D, text: string, x: number, y: number, maxW: number, lh: number) {
    let line = '';
    let row = 0;
    for (const word of text.split(' ')) {
      const next = line ? `${line} ${word}` : word;
      if (ctx.measureText(next).width > maxW && line) {
        ctx.fillText(line, x, y + row * lh);
        line = word;
        row++;
      } else line = next;
    }
    if (line) ctx.fillText(line, x, y + row * lh);
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-demo="reentrancy"]').forEach((canvas) => {
    const side = (w: number) => w >= 620;
    const controls = canvas.closest('figure')!.querySelector<HTMLElement>('[data-controls]')!;
    const toggleBtn = controls.querySelector<HTMLButtonElement>('[data-act="toggle"]')!;
    const count = controls.querySelector<HTMLElement>('[data-count]')!;
    const live = controls.querySelector<HTMLElement>('[data-live]')!;
    const dots = Array.from({ length: STEPS }, (_, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.setAttribute('aria-label', `${i + 1}단계로 이동`);
      b.addEventListener('click', () => go(i, false));
      controls.querySelector('[data-steps]')!.append(b);
      return b;
    });

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let step = 0;
    let stepStart = performance.now();
    let playing = !reduced;
    let shown = -1;

    const syncUi = (prog: number) => {
      dots.forEach((d, i) => {
        d.classList.toggle('on', i === step);
        d.classList.toggle('done', i < step);
      });
      dots[step].style.setProperty('--prog', `${Math.round(prog * 100)}%`);
      if (shown !== step) {
        shown = step;
        count.textContent = `${step + 1} / ${STEPS}`;
        const note = (sc: Scenario) => stateAt(sc, step + 0.99).note;
        live.textContent = `${note(reentrant)} / ${note(queued)}`;
      }
      toggleBtn.textContent = playing ? '❚❚' : '▶︎ 재생';
      toggleBtn.setAttribute('aria-label', playing ? '일시정지' : '재생');
    };

    const demo = mountDemo(canvas, {
      duration: 1,
      height: (w) => (side(w) ? PANEL_H : PANEL_H * 2 + 28),
      onEnter: (now) => { if (playing) { step = 0; stepStart = now; } },
      draw: (f) => {
        const { ctx, width, colors, now } = f;
        if (playing && now - stepStart >= STEP_MS[step]) {
          step = (step + 1) % STEPS;
          stepStart = now;
        }
        const elapsed = now - stepStart;
        const v = step + (reduced ? 0.99 : Math.min(0.99, elapsed / 1000));
        syncUi(playing ? Math.min(1, elapsed / STEP_MS[step]) : 1);
        if (side(width)) {
          const pw = (width - 32) / 2;
          drawPanel(f, reentrant, 0, 0, pw, v);
          ctx.strokeStyle = colors.line;
          ctx.beginPath();
          ctx.moveTo(pw + 16, 0);
          ctx.lineTo(pw + 16, PANEL_H);
          ctx.stroke();
          drawPanel(f, queued, pw + 32, 0, pw, v);
        } else {
          drawPanel(f, reentrant, 0, 0, width, v);
          ctx.strokeStyle = colors.line;
          ctx.beginPath();
          ctx.moveTo(0, PANEL_H + 14);
          ctx.lineTo(width, PANEL_H + 14);
          ctx.stroke();
          drawPanel(f, queued, 0, PANEL_H + 28, width, v);
        }
      },
    });

    // 버튼으로 옮기면 자동 재생을 멈추고 그 단계를 처음부터 보여 준다
    function go(next: number, keepPlaying: boolean) {
      step = Math.max(0, Math.min(STEPS - 1, next));
      stepStart = performance.now();
      playing = keepPlaying && !reduced;
      demo.redraw();
    }
    controls.querySelector('[data-act="prev"]')!.addEventListener('click', () => go(step - 1, false));
    controls.querySelector('[data-act="next"]')!.addEventListener('click', () => go(step + 1, false));
    toggleBtn.addEventListener('click', () => {
      if (playing) { playing = false; demo.redraw(); }
      else go(step === STEPS - 1 ? 0 : step, true);
    });
  });
</script>
