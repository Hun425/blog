---
// 이슈 #6241: useBlockingTaskExecutor(true)여도 (역)직렬화가 이벤트 루프에서 돌던 문제를 변경 전/후 타임라인으로 보여 준다.
import DemoFrame from './DemoFrame.astro';
---
<DemoFrame
  label="useBlockingTaskExecutor(true)일 때 이벤트 루프와 blocking 풀의 작업 타임라인 비교. 변경 전에는 요청 A의 압축 해제·역직렬화와 직렬화·압축이 이벤트 루프를 차지해 요청 B, C, D가 기다리고, 변경 후에는 그 작업이 blocking 풀로 옮겨져 B, C, D가 바로 처리된다."
  caption="큰 gzip 요청 A 하나가 들어온 동안의 타임라인. 시간은 개념적인 예시다."
>
  <canvas data-demo="eventloop-blocking"></canvas>
  <ul class="legend" slot="legend">
    <li><i style="--k:var(--accent)"></i>I/O·짧은 처리</li>
    <li><i style="--k:var(--c-algorithm)"></i>압축·(역)직렬화</li>
    <li><i style="--k:var(--c-infra)"></i>서비스 로직</li>
    <li><i class="hatch" style="--k:var(--c-career)"></i>이벤트 루프를 기다리는 요청</li>
  </ul>
</DemoFrame>

<script>
  import { mountDemo, roundRect, hatch, mix, fitText, taskBlock, type Frame } from './canvas';

  type Kind = 'io' | 'heavy' | 'logic';
  type Task = { lane: 0 | 1; from: number; to: number; label: string; short: string; kind: Kind };
  type Wait = { req: string; from: number; to: number };
  type Scenario = { title: string; code: string; tasks: Task[]; arrivals: [string, number][]; waits: Wait[] };

  const T = 80; // 타임라인 전체 길이(ms, 개념값)
  const arrivals: [string, number][] = [['B', 8], ['C', 16], ['D', 50]];

  const before: Scenario = {
    title: '변경 전',
    code: '(역)직렬화는 여전히 이벤트 루프에서',
    arrivals,
    tasks: [
      { lane: 0, from: 0, to: 3, label: 'A', short: 'A', kind: 'io' },
      { lane: 0, from: 3, to: 30, label: 'A gzip 해제 + 역직렬화', short: 'A 역직렬화', kind: 'heavy' },
      { lane: 0, from: 30, to: 35, label: 'B', short: 'B', kind: 'io' },
      { lane: 0, from: 35, to: 40, label: 'C', short: 'C', kind: 'io' },
      { lane: 1, from: 30, to: 44, label: 'A 서비스 로직', short: 'A 로직', kind: 'logic' },
      { lane: 0, from: 44, to: 66, label: 'A 직렬화 + gzip 압축', short: 'A 직렬화', kind: 'heavy' },
      { lane: 0, from: 66, to: 69, label: 'A', short: 'A', kind: 'io' },
      { lane: 0, from: 69, to: 74, label: 'D', short: 'D', kind: 'io' },
    ],
    waits: [
      { req: 'B', from: 8, to: 30 },
      { req: 'C', from: 16, to: 35 },
      { req: 'D', from: 50, to: 69 },
    ],
  };

  const after: Scenario = {
    title: '변경 후',
    code: '(역)직렬화도 blocking 풀에서',
    arrivals,
    tasks: [
      { lane: 0, from: 0, to: 3, label: 'A', short: 'A', kind: 'io' },
      { lane: 1, from: 3, to: 30, label: 'A gzip 해제 + 역직렬화', short: 'A 역직렬화', kind: 'heavy' },
      { lane: 0, from: 8, to: 13, label: 'B', short: 'B', kind: 'io' },
      { lane: 0, from: 16, to: 21, label: 'C', short: 'C', kind: 'io' },
      { lane: 1, from: 30, to: 44, label: 'A 서비스 로직', short: 'A 로직', kind: 'logic' },
      { lane: 1, from: 44, to: 66, label: 'A 직렬화 + gzip 압축', short: 'A 직렬화', kind: 'heavy' },
      { lane: 0, from: 50, to: 55, label: 'D', short: 'D', kind: 'io' },
      { lane: 0, from: 66, to: 69, label: 'A', short: 'A', kind: 'io' },
    ],
    waits: [],
  };

  const LANE_H = 30;
  const LANE_GAP = 8;
  const WAIT_H = 14;
  const HEAD_H = 46; // 제목 + 도착 표시 줄
  const PANEL_H = HEAD_H + LANE_H * 2 + LANE_GAP + 10 + WAIT_H * 3 + 6 + 22;
  const PANEL_GAP = 26;

  function drawPanel(f: Frame, s: Scenario, top: number) {
    const { ctx, width, colors: c, font, mono } = f;
    const now = f.p * T;
    const narrow = width < 520;
    const labelW = narrow ? 70 : 96;
    const x0 = labelW;
    const x1 = width - 8;
    const X = (t: number) => x0 + (t / T) * (x1 - x0);
    const kindColor: Record<Kind, string> = { io: c.accent, heavy: c.orange, logic: c.teal };

    // 제목
    ctx.textBaseline = 'alphabetic';
    ctx.textAlign = 'left';
    ctx.font = `700 14px ${font}`;
    ctx.fillStyle = c.ink;
    ctx.fillText(s.title, 0, top + 14);
    const tw = ctx.measureText(s.title).width;
    ctx.font = `400 12.5px ${font}`;
    ctx.fillStyle = c.ink3;
    fitText(ctx, s.code, tw + 10, top + 14, width - tw - 10);

    // 레인
    const laneY = [top + HEAD_H, top + HEAD_H + LANE_H + LANE_GAP];
    const laneNames = ['이벤트 루프', 'blocking 풀'];
    laneY.forEach((y, i) => {
      ctx.font = `600 ${narrow ? 11 : 12.5}px ${font}`;
      ctx.fillStyle = c.ink2;
      ctx.textBaseline = 'middle';
      ctx.fillText(laneNames[i], 0, y + LANE_H / 2);
      roundRect(ctx, x0, y, x1 - x0, LANE_H, 6);
      ctx.fillStyle = c.surface2;
      ctx.fill();
    });

    // 도착 표시
    for (const [req, t] of s.arrivals) {
      if (now < t) continue;
      const x = X(t);
      ctx.fillStyle = c.pink;
      ctx.beginPath();
      ctx.moveTo(x - 4, laneY[0] - 9);
      ctx.lineTo(x + 4, laneY[0] - 9);
      ctx.lineTo(x, laneY[0] - 3);
      ctx.fill();
      ctx.font = `700 10.5px ${mono}`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'alphabetic';
      ctx.fillText(req, x, laneY[0] - 11);
      ctx.textAlign = 'left';
    }

    // 작업 블록
    for (const t of s.tasks) {
      if (now <= t.from) continue;
      const end = Math.min(now, t.to);
      const x = X(t.from) + 1;
      const w = X(end) - X(t.from) - 2;
      const y = laneY[t.lane] + 3;
      const col = t.kind === 'io' ? mix(kindColor[t.kind], 0.85) : kindColor[t.kind];
      taskBlock(f, x, y, w, LANE_H - 6, col, t.label, t.short, X(t.to) - X(t.from));
    }

    // 대기 행
    const waitTop = laneY[1] + LANE_H + 10;
    ctx.font = `600 ${narrow ? 11 : 12}px ${font}`;
    ctx.fillStyle = c.ink3;
    ctx.textBaseline = 'middle';
    ctx.fillText('대기', 0, waitTop + (WAIT_H * 3) / 2);
    if (s.waits.length === 0) {
      ctx.font = `500 12px ${font}`;
      ctx.fillStyle = c.ink3;
      if (now > 8) ctx.fillText('도착하자마자 처리된다', x0 + 4, waitTop + (WAIT_H * 3) / 2);
    }
    s.waits.forEach((w, i) => {
      if (now <= w.from) return;
      const y = waitTop + i * WAIT_H + 1;
      const end = Math.min(now, w.to);
      hatch(ctx, X(w.from), y, X(end) - X(w.from), WAIT_H - 3, c.pink);
      ctx.font = `700 10px ${mono}`;
      ctx.fillStyle = c.pink;
      ctx.textBaseline = 'middle';
      ctx.textAlign = 'right';
      ctx.fillText(w.req, X(w.from) - 4, y + (WAIT_H - 3) / 2);
      ctx.textAlign = 'left';
    });

    // 재생 위치
    if (f.p < 1) {
      const px = X(now);
      ctx.strokeStyle = mix(c.ink, 0.35);
      ctx.setLineDash([3, 3]);
      ctx.beginPath();
      ctx.moveTo(px, laneY[0] - 2);
      ctx.lineTo(px, waitTop + WAIT_H * 3);
      ctx.stroke();
      ctx.setLineDash([]);
    }

    // 대기 합계
    const waited = s.waits.reduce((sum, w) => sum + Math.max(0, Math.min(now, w.to) - w.from), 0);
    const sumY = waitTop + WAIT_H * 3 + 6 + 11;
    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';
    ctx.font = `500 12.5px ${font}`;
    const value = `${Math.round(waited)} ms`;
    ctx.font = `700 13px ${mono}`;
    const vw = ctx.measureText(value).width;
    ctx.fillStyle = waited > 0 ? c.pink : c.teal;
    ctx.fillText(value, x1, sumY);
    ctx.font = `500 12.5px ${font}`;
    ctx.fillStyle = c.ink2;
    ctx.fillText('B·C·D가 기다린 시간 합계 ', x1 - vw, sumY);
    ctx.textAlign = 'left';
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-demo="eventloop-blocking"]').forEach((canvas) => {
    mountDemo(canvas, {
      duration: 7000,
      height: () => PANEL_H * 2 + PANEL_GAP,
      draw: (f) => {
        drawPanel(f, before, 0);
        const { ctx, width, colors } = f;
        ctx.strokeStyle = colors.line;
        ctx.beginPath();
        ctx.moveTo(0, PANEL_H + PANEL_GAP / 2);
        ctx.lineTo(width, PANEL_H + PANEL_GAP / 2);
        ctx.stroke();
        drawPanel(f, after, PANEL_H + PANEL_GAP);
      },
    });
  });
</script>
